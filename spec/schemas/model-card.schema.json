{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai4s-governance/model-card.schema.json",
  "title": "Model card front matter",
  "description": "YAML front matter of a model card. The body must contain the eight sections described in docs/06-knowledge.md.",
  "type": "object",
  "required": ["编号", "标题", "场景", "版本", "owner", "状态", "置信", "重要性"],
  "properties": {
    "编号": { "type": "string", "pattern": "^MODEL-[A-Z][0-9]{1,3}$" },
    "标题": { "type": "string", "minLength": 1 },
    "场景": { "type": "string", "minLength": 1 },
    "版本": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "owner": { "type": "string", "minLength": 2 },
    "状态": { "enum": ["草稿", "已审", "DEPRECATED"] },
    "置信": { "enum": ["L0", "L1", "L2", "L3"] },
    "重要性": { "type": "integer", "minimum": 1, "maximum": 10 },
    "superseded_by": { "type": ["string", "null"] },
    "复核人": { "type": "string" },
    "复核日期": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "additionalProperties": true
}
